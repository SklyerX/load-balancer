# Where backends register. Must match deployment.yaml's port.
LB_URL=http://localhost:8888

# Signing key for the registration token.
# Must match BACKEND_JWT_SECRET in the balancer's .env
JWT_SECRET=change-me

# Region reported to the balancer at registration.
REGION=NAE

# 0 disables all failure injection, leaving only latency.
CHAOS=1

# Same seed replays the same failure run.
SEED=1337

# Heartbeat interval in ms. 0 disables heartbeats.
HEARTBEAT_MS=2000

# Control plane port.
CONTROL_PORT=9999
